# Copy to web/.env.local for local development, and set the same names in Vercel.
# Never commit the real values — .gitignore excludes .env* everywhere except this file.

# --- Database -----------------------------------------------------------------
# Neon pooled connection string. The collector and the web app both read it.
# With this unset, the web app falls back to web/fixtures/snapshot.json so the UI
# still runs against real exported data.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Web push -----------------------------------------------------------------
# Generate a pair with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is served to browsers; the private key must stay server-side only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Only alerts at or above this Move Strength trigger a notification.
ALERT_MIN_STRENGTH=60

# Shared secret the collector sends as "Authorization: Bearer ..." when calling
# /api/dispatch-alerts. That route makes the phone buzz, so it must not be
# triggerable by anyone who finds the URL.
ALERT_DISPATCH_SECRET=

# --- Optional -----------------------------------------------------------------
# College Football Data API key. Not used in v1 (CFBD publishes no prices).
CFBD_KEY=

# --- Access -------------------------------------------------------------------
# Passcode required to open the app. With this UNSET the site is reachable by
# anyone who finds the URL — including /api/bets and /api/book-lines, which accept
# writes — and the header shows a red "unlocked" badge saying so.
# Set it in Vercel, not here.
APP_PASSCODE=

# Optional second passcode: a guest. Share this one; never the other.
#
# A guest reads the whole market -- board, line shopping, track record -- and keeps a
# ledger of their own, kept against an anonymous id in a cookie with no account behind
# it. What they cannot touch is anything SHARED: the consensus, the settings the
# notification dispatcher reads, my phone.
#
# Survivor is owner-only for a different reason, and the more important one: strategy,
# not privacy. The planner's entire value comes from not holding the same ticket as the
# field, so showing a pool rival the pick gives away the edge it spent the run computing.
#
# Unset means there are simply no guests; the app still works exactly as before.
APP_VIEWER_PASSCODE=
